# The Postgres that visit runs (postgres/README.md). Bump these, run the `postgres` workflow, then postgres/pin.
POSTGRES_VERSION=18.6
# ours: a rebuild of the same Postgres (other flags, a newer base) gets the next number
BUILD=1
# the source tarball's sha256, as ftp.postgresql.org publishes it (postgresql-$POSTGRES_VERSION.tar.bz2.sha256)
POSTGRES_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
# macOS and Windows: theseus-rs/postgresql-binaries' build of the same Postgres, checked against its .sha256
THESEUS_RELEASE=18.6.1
# Linux is built here, on glibc 2.28 (manylinux_2_28: Debian 10+, Ubuntu 20.04+, RHEL 8+), and tested on Ubuntu 20.04
LINUX_IMAGE_X86_64=quay.io/pypa/manylinux_2_28_x86_64@sha256:e0adf18521ad35192df733a6c62d35df7801957d24e0470238aacecfab2188a3
LINUX_IMAGE_AARCH64=quay.io/pypa/manylinux_2_28_aarch64@sha256:a3e02308c822fb6ce0d12248b0c941817ba5e1a1bc9e7bb5929f29c50eaa40a9
LINUX_TEST_IMAGE=ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214
