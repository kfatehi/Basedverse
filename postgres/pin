#!/usr/bin/env bash
# Pins visit to the published release postgres-<version>-<build> (postgres/versions.env): writes
# visit/client/postgres.json, the file names and sha256s visit is built with. It downloads only the archive for
# its platform, from that release, and refuses one whose sha256 is not the pinned one. Commit what it changed.
#   postgres/pin
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=versions.env
source "$here/versions.env"
repo="${POSTGRES_REPO:-sarmiena/Basedverse}"
tag="postgres-$POSTGRES_VERSION-$BUILD"
url="https://github.com/$repo/releases/download/$tag/"
sums=$(curl -fsSL "${url}SHA256SUMS") || { echo "postgres/pin: no ${url}SHA256SUMS: run the postgres workflow with publish first" >&2; exit 1; }
out="$here/../visit/client/postgres.json"
{
  echo "{"
  echo "  \"postgres\": \"$POSTGRES_VERSION\","
  echo "  \"build\": $BUILD,"
  echo "  \"url\": \"$url\","
  echo "  \"files\": {"
  sep=""
  for platform in linux-x86_64 linux-aarch64 macos-aarch64 macos-x86_64 windows-x86_64; do
    name="postgresql-$POSTGRES_VERSION-$BUILD-$platform.tar.gz"
    sha=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' <<<"$sums")
    [ -n "$sha" ] || { echo "postgres/pin: $tag has no $name" >&2; exit 1; }
    printf '%s    "%s": { "name": "%s", "sha256": "%s" }' "$sep" "$platform" "$name" "$sha"
    sep=$',\n'
  done
  echo
  echo "  }"
  echo "}"
} >"$out.new"
mv "$out.new" "$out"
echo "postgres/pin: visit/client/postgres.json now pins $tag"
