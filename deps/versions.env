# What is built into visit (deps/README.md): Postgres and a headless Chrome, at these versions, from these inputs.
# To upgrade one: change it here, push (the deps workflow builds and tests it on every platform), tag deps-<n>,
# then deps/pin <n> and commit. A *_BUILD is ours: the next number rebuilds the same version (other flags, a newer
# base); a new version starts at 1.

POSTGRES_VERSION=18.6
POSTGRES_BUILD=1
# the source tarball's sha256, as ftp.postgresql.org publishes it (postgresql-$POSTGRES_VERSION.tar.bz2.sha256)
POSTGRES_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
# Windows only: theseus-rs/postgresql-binaries' build of the same Postgres (postgresql-<release>-x86_64-pc-windows-msvc.tar.gz)
THESEUS_RELEASE=18.6.1
THESEUS_SHA256_WINDOWS_X86_64=0c0c845626ed77c605d716051c9e8df3368d07fbbd9f61ea39a4c5c0536fde7e

# Chrome for Testing's chrome-headless-shell (googlechromelabs.github.io/chrome-for-testing). It publishes no
# checksums: these are ours, of the zips as first downloaded, so a different file is refused.
CHROME_VERSION=156.0.8078.73
CHROME_BUILD=1
CHROME_SHA256_LINUX_X86_64=77eb8d52798efc7a857ab61abcc62a456d8ea9635b02341d06dffee2761768c8
CHROME_SHA256_LINUX_AARCH64=98c084708f0f1fa4ed589ad601cc79b437f0cebe60ffc9794af78a085c01a2a7
CHROME_SHA256_MACOS_AARCH64=512c7d34cd5b65d617a39a48915b490eed4208a63e9d47b0fd7893e83be85765
CHROME_SHA256_MACOS_X86_64=be798095cd693357a7a6a0e7a0c4ebd81563e16f51225eb98aacc906d6326519
CHROME_SHA256_WINDOWS_X86_64=e6d26810df71efd0a3dfd0f7246d75d279ebdf8a8ec153d1ac44069657298628

# Linux is built on glibc 2.28 (manylinux_2_28, AlmaLinux 8: Debian 10+, Ubuntu 20.04+, RHEL 8+), and tested on
# bare images with nothing installed: an older C library than the build's, and a current one.
LINUX_IMAGE_X86_64=quay.io/pypa/manylinux_2_28_x86_64@sha256:e0adf18521ad35192df733a6c62d35df7801957d24e0470238aacecfab2188a3
LINUX_IMAGE_AARCH64=quay.io/pypa/manylinux_2_28_aarch64@sha256:a3e02308c822fb6ce0d12248b0c941817ba5e1a1bc9e7bb5929f29c50eaa40a9
LINUX_TEST_IMAGES="ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214 debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3"
# macOS builds run on the runner itself, for macOS 11 (Big Sur) and later
MACOS_DEPLOYMENT_TARGET=11.0
