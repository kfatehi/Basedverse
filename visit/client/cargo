#!/usr/bin/env bash
# cargo, in the official Rust image: nothing to install on this machine. The crate registry and the build
# output live in Docker volumes (visit-cargo, visit-target), owned by you; the network is the host's, so a
# test can reach a lobby on 127.0.0.1.
#   ./cargo build --release        ./cargo test        ./cargo run -- --help
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
image="${RUST_IMAGE:-rust:1-bookworm}"
for v in visit-cargo visit-target; do docker volume create "$v" >/dev/null; done
docker run --rm -v visit-cargo:/cargo -v visit-target:/target "$image" chown "$(id -u):$(id -g)" /cargo /target
tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
exec docker run --rm -i "${tty[@]}" -u "$(id -u):$(id -g)" -e CARGO_HOME=/cargo -e CARGO_TARGET_DIR=/target \
  -v visit-cargo:/cargo -v visit-target:/target -v "$here":/src -w /src --network host "$image" cargo "$@"
