# basedverse's settings: a template, with nothing real in it. Copy what you need into a .env (never
# committed; .gitignore keeps it out) and fill it in. Blank means the default. `bin/setup` writes the first
# section into a workroom's .env for you, asking for what it needs.

# -- A workroom's visit-client (visit/INTEGRATING.md, step 2) ---------------------------------------------
# visit-client reads these from its environment (each is also a flag: VISIT_PORT is --port). A workroom
# keeps them in its own settings, its .env say, starting from this section, and its launcher passes them on.

# The lobby's address, from whoever runs it: wss://<its IP address or DNS name>/
VISIT_LOBBY=
# The office's name in the lobby: 1-24 letters, digits, space, _ . -, starting and ending with a letter or
# digit. In quotes if it has a space ("My Room"), so a shell can load this file too.
VISIT_NAME=
# The sim, as name/version, shown to others, e.g. my-workroom/1.0 (default unknown/0).
VISIT_SIM=
# visit-client's port on 127.0.0.1, for the workroom's page (default 7401).
VISIT_PORT=
# How many visitors the room takes at once, 0-8 (default 3).
VISIT_MAX_VISITORS=
# The page's origins, comma-separated: scheme://host:port as the address bar shows them, e.g.
# http://localhost:3000,http://127.0.0.1:3000. visit-client refuses any other site's page, token or not.
# Blank lets any page with the token in: name yours.
VISIT_ORIGINS=
# The file the launcher writes a new page token to on every run (mode 0600). The token itself never goes
# in a .env: it is new each run.
VISIT_TOKEN_FILE=
# The relays for links, overriding the lobby's: none, default (iroh's public ones), or comma-separated
# URLs (default: the ones the lobby names).
VISIT_RELAYS=
# Exit after this many seconds with no page connected (default 0: never).
VISIT_IDLE_EXIT=
# Not visit-client's but its launcher's: where visit-client is (bin/setup puts it in
# visit/client/bin/ and writes its path here).
VISIT_CLIENT_PATH=

# -- Running the lobby (lobby/README.md, "Put it on a server") -------------------------------------------
# The server bin/deploy-lobby deploys to (user@host, e.g. ubuntu@203.0.113.5) and its ssh key file, if
# ssh needs one. It fills these in itself on the first deploy.
LOBBY_DEPLOY=
LOBBY_DEPLOY_KEY=
# The directory it deploys into on the server (default basedverse-lobby), for a server set up
# under another name.
LOBBY_DEPLOY_DIR=
# The address of the lobby it last deployed (it writes it; bin/setup offers it).
LOBBY_DEPLOY_URL=
