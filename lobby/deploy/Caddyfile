# TLS in front of the lobby: a free Let's Encrypt certificate for LOBBY_HOST, which may be a bare IPv4
# address. Let's Encrypt issues IP certificates only under its `shortlived` profile (6 days); Caddy renews
# them by itself. Needs ports 80 and 443 open to the internet for the ACME challenges.
{$LOBBY_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	reverse_proxy lobby:8765
}
